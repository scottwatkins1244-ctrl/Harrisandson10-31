# Live harrisandsons.co response headers (1:1). Per-page Link + Cache-Control for HTML are set in functions/_middleware.js
# because Cloudflare Pages allows max 100 _headers rules and live sends a unique Link per page.

/local-sitemap.xml
  Content-Type: text/xml; charset=UTF-8
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  X-Robots-Tag: noindex

/locations.kml
  Content-Type: text/xml; charset=UTF-8
  Cache-Control: public, max-age=2678400

/main-sitemap.xsl
  Content-Type: text/xml; charset=UTF-8
  Cache-Control: public, max-age=31535999
  X-Robots-Tag: noindex

/page-sitemap.xml
  Content-Type: text/xml; charset=UTF-8
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  X-Robots-Tag: noindex

/post-sitemap.xml
  Content-Type: text/xml; charset=UTF-8
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  X-Robots-Tag: noindex

/robots.txt
  Content-Type: text/plain
  Cache-Control: public, max-age=2678400

/sitemap_index.xml
  Content-Type: text/xml; charset=UTF-8
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  X-Robots-Tag: noindex

/video-sitemap.xml
  Content-Type: text/xml; charset=UTF-8
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  X-Robots-Tag: noindex

/video-sitemap.xsl
  Content-Type: text/xml; charset=UTF-8
  Cache-Control: public, max-age=31536000
  X-Robots-Tag: noindex

/404.html
  Content-Type: text/html; charset=UTF-8

/
  Content-Type: text/html; charset=UTF-8

/:slug/
  Content-Type: text/html; charset=UTF-8

/category/:cat/
  Content-Type: text/html; charset=UTF-8
