elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-80eec74\" data-id=\"80eec74\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-a7810f5 elementor-widget elementor-widget-html\" data-id=\"a7810f5\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<script type=\"application\/ld+json\">\n{\n  \"@context\": \"https:\/\/schema.org\",\n  \"@type\": \"FAQPage\",\n  \"mainEntity\": [{\n    \"@type\": \"Question\",\n    \"name\": \"How long does a kitchen remodel in Hillsboro, OR typically take?\",\n    \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"The timeline for a kitchen remodel in Hillsboro, OR depends on the size and scope of the project. On average, most remodels take between 6\u201312 weeks from demolition to completion. Factors like custom cabinetry, special material orders, or structural changes can extend the timeline, but we\u2019ll always provide a clear schedule so you know what to expect.\"\n    }\n  },{\n    \"@type\": \"Question\",\n    \"name\": \"Will I be able to use my kitchen during the remodel in Hillsboro, OR?\",\n    \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"In most cases, your kitchen will be partially or fully unusable during the remodel. However, we\u2019ll work with you to set up a temporary cooking space when possible, so your daily life is minimally disrupted. Our goal is to complete your Hillsboro remodel efficiently while ensuring high-quality craftsmanship.\"\n    }\n  },{\n    \"@type\": \"Question\",\n    \"name\": \"How much does a kitchen remodel cost?\",\n    \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"Kitchen remodel costs vary based on size, materials, and complexity. We provide transparent, itemized estimates during your consultation, so there are no surprises.\"\n    }\n  },{\n    \"@type\": \"Question\",\n    \"name\": \"Can I choose my own materials and finishes?\",\n    \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"Absolutely. You have full control over selecting cabinets, countertops, tiles, appliances, and more. We also offer expert guidance to help you make the right choices.\"\n    }\n  },{\n    \"@type\": \"Question\",\n    \"name\": \"Do I need permits for a kitchen remodel?\",\n    \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"Yes, depending on the scope of the remodel, permits may be required\u2014especially for plumbing, electrical, or structural changes. Don\u2019t worry\u2014we\u2019ll handle all the paperwork for you.\"\n    }\n  }]\n}\n<\/script>\n\n\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<section class=\"elementor-section elementor-inner-section elementor-element elementor-element-7ee4e21 elementor-section-full_width elementor-section-height-default elementor-section-height-default\" data-id=\"7ee4e21\" data-element_type=\"section\" data-e-type=\"section\" data-settings=\"{&quot;jet_parallax_layout_list&quot;:[]}\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-inner-column elementor-element elementor-element-538a615\" data-id=\"538a615\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-8972ef4 elementor-widget elementor-widget-text-editor\" data-id=\"8972ef4\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p><span style=\"color: #808080;\">Hear From Our<br \/