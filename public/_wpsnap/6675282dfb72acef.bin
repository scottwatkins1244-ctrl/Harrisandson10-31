-widget-ucaddon_image_reveal_on_scroll\" data-id=\"e3537a6\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"ucaddon_image_reveal_on_scroll.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\n<!-- start Scroll Image Reveal -->\n\t\t<link id='uc_ac_assets_file_uc_image_reveal_css_545-css' href='https:\/\/harrisandsons.co\/wp-content\/uploads\/ac_assets\/image_reveal_on_scroll\/uc_image_reveal.css' type='text\/css' rel='stylesheet' >\n\n<style>\/* widget: Scroll Image Reveal *\/\n\n    #uc_image_reveal_on_scroll_elementor_e3537a6 .uc_overlay{\n      right: 0;\n\t} \n\t\n\n\n\n\n#uc_image_reveal_on_scroll_elementor_e3537a6 .uc_reveal{\n\ttransition: ease-in-out all 2s;\n    transition-delay: 250ms;\n}\n\n#uc_image_reveal_on_scroll_elementor_e3537a6 img\n{\n  display:block;\n}\n\n<\/style>\n\n<div class=\"uc_image_reveal\" id=\"uc_image_reveal_on_scroll_elementor_e3537a6\">\n\t<div class=\"uc_image_reveal_box\">\n      \t          \n\t\t<img loading=\"lazy\" decoding=\"async\" src=\"https:\/\/harrisandsons.co\/wp-content\/uploads\/2024\/06\/1411568-Enhanced-NR-e1754938703425.jpg\" class=\"ue-img\" alt=\"\" width=\"100%\"  src=\"https:\/\/harrisandsons.co\/wp-content\/uploads\/2024\/06\/1411568-Enhanced-NR-e1754938703425.jpg\" alt=\"harrisandsons\" width=\"1852\" height=\"1350\">\n          \n              \n\t\t<div class=\"uc_overlay iv-jello\"><\/div>\n        \n\t<\/div>\n<\/div>\n<!-- end Scroll Image Reveal -->\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-inner-column elementor-element elementor-element-f22f2fa\" data-id=\"f22f2fa\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-3a714b7 elementor-widget__width-auto elementor-widget elementor-widget-heading\" data-id=\"3a714b7\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Our promise<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-a9597d0 elementor-widget elementor-widget-text-editor\" data-id=\"a9597d0\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p><span style=\"color: #808080;\">Your Remodel <\/span><strong>Doesn&#8217;t Have To Be A Gamble\u00a0<\/strong><\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-5a213f7 elementor-widget elementor-widget-text-editor\" data-id=\"5a213f7\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p class=\"font-claude-response-body break-words whitespace-normal\">Maybe you&#8217;ve heard the horror stories. Contractors who disappear mid-project. Budgets that balloon. Timelines that never end. You just want someone who shows up, does what they said, and treats your home like it matters. That&#8217;s the whole reason Harris &amp; Sons exists. Over 40 years of hands-on experience, one job at a time, so you&#8217;re not the one stuck cleaning up a mess. Call us at <a href=\"tel:5413165836\"><strong>(541) 316-5836<\/strong> <\/a>and let our family take care of yours.\u00a0<\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-0b1cee4 elementor-widget elementor-widget-ucaddon_color_overlay_button\" data-id=\"0b1cee4\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"ucaddon_color_overlay_button.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\n<!-- start Overlay Button -->\n<style>\/* widget: Overlay Button *\/\n\n#uc_color_overlay_button_elementor_0b1cee4 a.color-overlay-link\n{\n  display:inline-block;\n  position:relative;\n  text-decoration:none;\n  overflow:hidden;\n}\n\n#uc_color_overlay_button_elementor_0b1cee4 a span.ue-color-overlay\n{\n  display:block;\n  position:absolute;\n  top:0px;\n  left:0px;\n}\n\n#uc_color_overlay_button_elementor_0b1cee4 a .ue-btn-txt\n{\n  position:relative;\n  display: flex;\n  align-items: center;\n  flex-direction: row;\n}\n#uc_color_overlay_button_elementor_0b1cee4 a .ue-btn-txt svg\n{\n  width:1em;\n  height:1em;\n}\n\n<\/style>\n\n<div id=\"uc_color_overlay_button_elementor_0b1cee4\" class=\"color-overlay-button\">\n  <a href=\"https:\/\/harrisandsons.co\/about-us\" class=\"color-overlay-link elementor-animation-grow\">\n    <span class=\"ue-color-overlay\"><\/span>\n    <span class=\"ue-btn-txt\">MEET OUR TEAM <i class='fas fa-arrow-circle-right'><\/i><\/span>\n  <\/a>\n<\/div>\n<!-- end Overlay Button -->\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<div class=\"elementor-element elementor-element-562eb92 elementor-hidden-desktop elementor-hidden-laptop elementor-hidden-tablet elementor-widget-divider--view-line elementor-widget elementor-widget-divider\" data-id=\"562eb92\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"divider.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<div class=\"elementor-divider\">\n\t\t\t<span class=\"elementor-divider-separator\">\n\t\t\t\t\t\t<\/span>\n\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<section class=\"elementor-section elementor-inner-section elementor-element elementor-element-ee3ef8d elementor-section-full_width elementor-reverse-mobile elementor-section-height-default elementor-section-height-default\" data-id=\"ee3ef8d\" data-element_type=\"section\" data-e-type=\"section\" data-settings=\"{&quot;jet_parallax_layout_list&quot;