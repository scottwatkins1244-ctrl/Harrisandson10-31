n-boxed elementor-section-height-default elementor-section-items-middle\" data-id=\"87d39ff\" data-element_type=\"section\" data-e-type=\"section\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;,&quot;jet_parallax_layout_list&quot;:[]}\">\n\t\t\t\t\t\t\t<div class=\"elementor-background-overlay\"><\/div>\n\t\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-44167c8\" data-id=\"44167c8\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<section class=\"elementor-section elementor-inner-section elementor-element elementor-element-af5a24d elementor-section-full_width elementor-reverse-mobile elementor-section-height-default elementor-section-height-default\" data-id=\"af5a24d\" data-element_type=\"section\" data-e-type=\"section\" data-settings=\"{&quot;jet_parallax_layout_list&quot;:[]}\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-inner-column elementor-element elementor-element-005fc1d\" data-id=\"005fc1d\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-615a239 elementor-widget elementor-widget-text-editor\" data-id=\"615a239\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p><span style=\"color: #808080;\">Elevate Your Home with<\/span> <strong>Stunning Vaulted Ceilings<\/strong><\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-bc815fb elementor-widget elementor-widget-text-editor\" data-id=\"bc815fb\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p data-start=\"333\" data-end=\"875\">At <strong data-start=\"336\" data-end=\"379\">Harris &amp; Sons Renovation &amp; Construction<\/strong>, we specialize in transforming ordinary rooms into architectural masterpieces with beautifully designed <strong data-start=\"484\" data-end=\"504\">vaulted ceilings<\/strong>. Whether you\u2019re aiming for a dramatic open-concept look or a cozy rustic charm, vaulted ceilings are one of the most impactful upgrades you can make to your home. Our expert craftsmen have helped hundreds of homeowners throughout the Pacific Northwest achieve more height, better lighting, and enhanced property value \u2014 all with timeless design and structural integrity.<\/p><p data-start=\"877\" data-end=\"1106\">From modern cathedral-style ceilings to exposed beam aesthetics, our team handles it all \u2014 <strong data-start=\"968\" data-end=\"1021\">design, engineering, permitting, and construction<\/strong>. We make it easy to create a space that feels bigger, brighter, and truly luxurious.<\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-inner-column elementor-element elementor-element-15807e8\" data-id=\"15807e8\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-ed5a7ca elementor-widget elementor-widget-image\" data-id=\"ed5a7ca\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img fetchpriority=\"high\" decoding=\"async\" width=\"800\" height=\"94\" src=\"https:\/\/harrisandsons.co\/wp-content\/uploads\/2025\/07\/Lets-Get-Started