038;ssl=1\">\n          \n              \n\t\t<div class=\"uc_overlay iv-jello\"><\/div>\n        \n\t<\/div>\n<\/div>\n<!-- end Scroll Image Reveal -->\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-inner-column elementor-element elementor-element-f9eaa7d\" data-id=\"f9eaa7d\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-4929539 elementor-widget elementor-widget-text-editor\" data-id=\"4929539\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p><span style=\"color: #808080;\">Seamless Process From<\/span> <strong>Concept to Completion<\/strong><\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-1bdcfb5 elementor-widget elementor-widget-text-editor\" data-id=\"1bdcfb5\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p data-start=\"2474\" data-end=\"2925\">At <a href=\"https:\/\/share.google\/gwM2ovux57i85a4fn\" style=\"color:#000000; text-decoration:underline;\" target=\"_blank\" rel=\"noopener\"><strong data-start=\"2477\" data-end=\"2494\">Harris &amp; Sons<\/strong><\/a>, we manage your entire vaulted ceiling project from start to finish. That means no stress, no delays, and no cutting corners. We begin every project with a <strong data-start=\"2651\" data-end=\"2680\">free in-home consultation<\/strong>, followed by 3D design renderings so you can visualize your new space before construction begins. Once you&#8217;re happy with the design, our licensed experts handle all permits, materials, and labor \u2014 with crystal-clear communication along the way.<\/p>\n&nbsp;\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-61e07c4 elementor-section-height-min-height elementor-section-boxed elementor-section-height-default elementor-section-items-middle\" data-id=\"61e07c4\" data-element_type=\"section\" data-e-type=\"section\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;,&quot;jet_parallax_layout_list&quot;:[]}\">\n\t\t\t\t\t\t\t<div class=\"elementor-background-overlay\"><\/div>\n\t\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-25b3d00\" data-id=\"25b3d00\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<section class=\"elementor-section elementor-inner-section elementor-element elementor-element-52152e2 elementor-section-full_width elementor-reverse-mobile elementor-section-height-default elementor-section-height-default\" data-id=\"52152e2\" data-element_type=\"section\" data-e-type=\"section\" data-settings=\"{&quot;jet_parallax_layout_list&quot;:[]}\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-inner-column elementor-element elementor-element-ddc5cde\" data-id=\"ddc5cde\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-aff2bf8 elementor-widget elementor-widget-text-editor\" data-id=\"aff2bf8\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p><strong>Ready to Raise the Roof?<\/strong><\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-842709e elementor-widget elementor-widget-text-editor\" data-id=\"842709e\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p data-start=\"3298\" data-end=\"3448\"><strong data-start=\"3298\" data-end=\"3377\">Let\u2019s bring your vision to life with soaring vaulted ceilings that impress.<\/strong> Schedule your <a href=\"https:\/\/harrisandsons.co\/contact-us\/\" style=\"color:#000000; text-decoration:underline;\"><strong data-start=\"3392\" data-end=\"3420\">free design consultation<\/strong><\/a> with Harris &amp; Sons today.<\/p>\n<p data-start=\"3450\" data-end=\"3600\">We\u2019ll show you real examples of vaulted ceiling transformations, explore design ideas together, and provide a detailed quote with transparent pricing.<\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-inner-column elementor-element elementor-element-9ca1dfd\" data-id=\"9ca1dfd\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-b75db6f elementor-widget elementor-widget-ucaddon_image_reveal_on_scroll\" data-id=\"b75db6f\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"ucaddon_image_reveal_on_scroll.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\n<!-- start Scroll Image Reveal -->\n\n<style>\/* widget: Scroll Image Reveal *\/\n\n    #uc_image_reveal_on_scroll_elementor_b75db6f .uc_overlay{\n      right: 0;\n\t} \n\t\n\n\n\n\n#uc_image_reveal_on_scroll_elementor_b75db6f .uc_reveal{\n\ttransition: