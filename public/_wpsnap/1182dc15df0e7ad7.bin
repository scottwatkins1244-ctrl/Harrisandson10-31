>\n<!-- end Overlay Button -->\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-inner-column elementor-element elementor-element-0ed5a07\" data-id=\"0ed5a07\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-4e0aa60 elementor-arrows-yes elementor-pagination-type-bullets elementor-review--has-separator elementor--star-style-star_fontawesome elementor-widget elementor-widget-reviews\" data-id=\"4e0aa60\" data-element_type=\"widget\" data-e-type=\"widget\" data-settings=\"{&quot;slides_per_view&quot;:&quot;2&quot;,&quot;slides_to_scroll&quot;:&quot;1&quot;,&quot;space_between&quot;:{&quot;unit&quot;:&quot;px&quot;,&quot;size&quot;:18,&quot;sizes&quot;:[]},&quot;show_arrows&quot;:&quot;yes&quot;,&quot;pagination&quot;:&quot;bullets&quot;,&quot;speed&quot;:500,&quot;autoplay&quot;:&quot;yes&quot;,&quot;autoplay_speed&quot;:5000,&quot;loop&quot;:&quot;yes&quot;,&quot;space_between_laptop&quot;:{&quot;unit&quot;:&quot;px&quot;,&quot;size&quot;:10,&quot;sizes&quot;:[]},&quot;space_between_tablet&quot;:{&quot;unit&quot;:&quot;px&quot;,&quot;size&quot;:10,&quot;sizes&quot;:[]},&quot;space_between_mobile&quot;:{&quot;unit&quot;:&quot;px&quot;,&quot;size&quot;:10,&quot;sizes&quot;:[]}}\" data-widget_type=\"reviews.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<div class=\"elementor-swiper\">\n\t\t\t\t\t<div class=\"elementor-main-swiper swiper\" role=\"region\" aria-roledescription=\"carousel\" aria-label=\"Slides\">\n\t\t\t\t<div class=\"swiper-wrapper\">\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"swiper-slide\" role=\"group\" aria-roledescription=\"slide\">\n\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial elementor-repeater-item-5b084ed\">\n\t\t\t\t\t\t\t<div class=\"elementor-testimonial__header\">\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial__image\">\n\t\t\t\t\t\t\t<img decoding=\"async\" src=\"https:\/\/lh3.googleusercontent.com\/a-\/ALV-UjVmxcOI0bSC53k4aa9bbUdjf6os9DV00Rm2lwURU7g6k2JKj3c=w144-h144-p-rp-mo-br100\" alt=\"APT 350\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t\t\t<cite class=\"elementor-testimonial__cite\"><span class=\"elementor-testimonial__name\">APT 350<\/span><div class=\"elementor-star-rating\"><i class=\"elementor-star-full\">&#xE934;<\/i><i class=\"elementor-star-full\">&#xE934;<\/i><i class=\"elementor-star-full\">&#xE934;<\/i><i class=\"elementor-star-full\">&#xE934;<\/i><i class=\"elementor-star-full\">&#xE934;<\/i><\/div><\/cite>\t\t\t\t\t<div class=\"elementor-testimonial__icon elementor-icon elementor-icon-\" aria-label=\"Read More\"><svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" width=\"800px\" height=\"800px\" viewBox=\"-3 0 262 262\" preserveAspectRatio=\"xMidYMid\"><path d=\"M255.878 133.451c0-10.734-.871-18.567-2.756-26.69H130.55v48.448h71.947c-1.45 12.04-9.283 30.172-26.69 42.356l-.244 1.622 38.755 30.023 2.685.268c24.659-22.774 38.875-56.282 38.875-96.027\" fill=\"#4285F4\"><\/path><path d=\"M130.55 261.1c35.248 0 64.839-11.605 86.453-31.622l-41.196-31.913c-11.024 7.688-25.82 13.055-45.257 13.055-34.523 0-63.824-22.773-74.269-54.25l-1.531.13-40.298 31.187-.527 1.465C35.393 231.798 79.49 261.1 130.55 261.1\" fill=\"#34A853\"><\/path><path d=\"M56.281 156.37c-2.756-8.123-4.351-16.827-4.351-25.82 0-8.994 1.595-17.697 4.206-25.82l-.073-1.73L15.26 71.312l-1.335.635C5.077 89.644 0 109.517 0 130.55s5.077 40.905 13.925 58.602l42.356-32.782\" fill=\"#FBBC05\"><\/path><path d=\"M130.55 50.479c24.514 0 41.05 10.589 50.479 19.438l36.844-35.974C195.245 12.91 165.798 0 130.55 0 79.49 0 35.393 29.301 13.925 71.947l42.211 32.783c10.59-31.477 39.891-54.251 74.414-54.251\" fill=\"#EB4335\"><\/path><\/svg><\/div>\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial__content\">\n\t\t\t\t\t<div class=\"elementor-testimonial__text\">\n\t\t\t\t\t\tWe hired Harris & Sons to remodel part of our house and also build an addition. The project involved 3 bedrooms, 2 walk-in closets, and 2 bathrooms. Throughout the construction process, which had a few unforeseen complications, Harris & Sons worked to meet our expectations, gave us constructive options, and pushed to keep as close to the schedule as possible. They worked with us on controlling overall cost and understood and respected our financial capabilities and limits. In the end they gave us a beautiful and good quality home.\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"swiper-slide\" role=\"group\" aria-roledescription=\"slide\">\n\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial elementor-repeater-item-6136709\">\n\t\t\t\t\t\t\t<div class=\"elementor-testimonial__header\">\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial__image\">\n\t\t\t\t\t\t\t<img decoding=\"async\" src=\"https:\/\/lh3.googleusercontent.com\/a-\/ALV-UjUV5vQ-oluxDVs-KzV-HuRdv-XOk4HjIy6yI77mxK956v4lCKQ=w144-h144-p-rp-mo-ba2-br100\" alt=\"Derek Cutler\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t\t\t<cite class=\"elementor-testimonial__cite\"><span class=\"elementor-testimonial__name\">Derek Cutler<\/span><div class=\"elementor-star-rating\"><i class=\"elementor-star-full\">&#xE934;<\/i><i class=\"elementor-star-full\">&#xE934;<\/i><i class=\"elementor-star-full\">&#xE934;<\/i><i class=\"elementor-star-full\">&#xE934;<\/i><i class=\"elementor-star-full\">&#xE934;<\/i><\/div><\/cite>\t\t\t\t\t<div class=\"elementor-testimonial__icon elementor-icon elementor-icon-\" aria-label=\"Read More\"><svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" width=\"800px\" height=\"800px\" viewBox=\"-3 0 262 262\" preserveAspectRatio=\"xMidYMid\"><path d=\"M255.878 133.451c0-10.734-.871-18.567-2.756-26.69H130.55v48.448h71.947c-1.45 12.04-9.283 30.172-26.69 42.356l-.244 1.622 38.755 30.023 2.685.268c24.659-22.774 38.875-56.282 38.875-96.027\" fill=\"#4285F4\"><\/path><path d=\"M130.55 261.1c35.248 0 64.839-11.605 86.453-31.622l-41.196-31.913c-11.024 7.688-25.82 13.055-45.257 13.055-34.523 0-63.824-22.773-74.269-54.25l-1.531.13-40.298 31.187-.527 1.465C35.393 231.798 79.49 261.1 130.55 261.1\" fill=\"#34A853\"><\/path><path d=\"M56.281 156.37c-2.756-8.123-4.351-16.827-4.351-25.82 0-8.994 1.595-17.697 4.206-25.82l-.073-1.73L15.26 71.312l-1.335.635C5.077 89.644 0 109.517 0 130.55s5.077 40.905 13.925 58.602l42.356-32.782\" fill=\"#FBBC05\"><\/path><path d=\"M130.55 50.479c24.514 0 41.05 10.589 50.479 19.438l36.844-35.974C195.245 12.91 165.798 0 130.55 0 79.49 0 35.393 29.301 13.925 71.947l42.211 32.783c10.59-31.477 39.891-54.251 74.414-54.251\" fill=\"#EB4335\"><\/path><\/svg><\/div>\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial__content\">\n\t\t\t\t\t<div class=\"elementor-testimonial__text\">\n\t\t\t\t\t\tFrom our first meeting, Christian Harris stood out. Not only is he incredibly knowledgeable about construction and design, but he also brought a level of calm confidence that made us feel like our home was in the best possible hands. He took the time to understand our vision, walked us through every step of the process, and communicated consistently, something that\u2019s rare in the construction world these days.\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"swiper-slide\" role=\"group\" aria-roledescription=\"slide\">\n\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial elementor-repeater-item-ffe5b18\">\n\t\t\t\t\t\t\t<div class=\"elementor-testimonial__header\">\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial__image\">\n\t\t\t\t\t\t\t<img decoding=\"async\" src=\"https:\/\/lh3.googleusercontent.com\/a-\/ALV-UjVVEmbU_XahIWcgpCyBFasXVoLaGxKad7j-JZyK2f2QjTSWeRg=w144-h144-p-rp-mo-br100\" alt=\"Lou P\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t\t\t<cite class=\"elementor-testimonial__cite\"><span class=\"elementor-testimonial__name\">Lou P<\/span><div class=\"elementor-star-rating\"><i class=\"elementor-star-full\">&#xE934;<\/i><i class=\"elementor-star-full\">&#xE934;<\/i><i class=\"elementor-star-full\">&#xE934;<\/i><i class=\"elementor-star-full\">&#xE934;<\/i><i class=\"elementor-star-full\">&#xE934;<\/i><\/div><\/cite>\t\t\t\t\t<div class=\"elementor-testimonial__icon elementor-icon elementor-icon-\" aria-label=\"Read More\"><svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" width=\"800px\" height=\"800px\" viewBox=\"-3 0 262 262\" preserveAspectRatio=\"xMidYMid\"><path d=\"M255.878 133.451c0-10.734-.871-18.567-2.756-26.69H130.55v48.448h71.947c-1.45 12.04-9.283 30.172-26.69 42.356l-.244 1.622 38.755 30.023 2.685.268c24.659-22.774 38.875-56.282 38.875-96.027\" fill=\"#4285F4\"><\/path><path d=\"M130.55 261.1c35.248 0 64.839-11.605 86.453-31.622l-41.196-31.913c-11.024 7.688-25.82 13.055-45.257 13.055-34.523 0-63.824-22.773-74.269-54.25l-1.531.13-40.298 31.187-.527 1.465C35.393 231.798 79.49 261.1 130.55 261.1\" fill=\"#34A853\"><\/path><path d=\"M56.281 156.37c-2.756-8.123-4.351-16.827-4.351-25.82 0-8.994 1.595-17.697 4.206-25.82l-.073-1.73L15.26 71.312l-1.335.635C5.077 89.644 0 109.517 0 130.55s5.077 40.905 13.925 58.602l42.356-32.782\" fill=\"#FBBC05\"><\/path><path d=\"M130.55 50.479c24.514 0 41.05 10.589 50.479 19.438l36.844-35.974C195.245 12.91 165.798 0 130.55 0 79.49 0 35.393 29.301 13.925 71.947l42.211 32.783c10.59-31.477 39.891-54.251 74.414-54.251\" fill=\"#EB4335\"><\/path><\/svg><\/div>\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial__content\">\n\t\t\t\t\t<div class=\"elementor-testimonial__text\">\n\t\t\t\t\t\tI met with Christian and a tall young man whose name escapes me, and was very impressed by their professionalism. They gave me a quote for remodeling after major water damage. Sadly I couldn't use them as I was fighting with my insurance company at the time!! I still think about the awesome job I KNOW they would've done for me and am still upset it never happened. Bobbie Pierson\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"swiper-slide\" role=\"group\" aria-roledescription=\"slide\">\n\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial elementor-repeater-item-7c30109\">\n\t\t\t\t\t\t\t<div class=\"elementor-testimonial__header\">\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial__image\">\n\t\t\t\t\t\t\t<img decoding=\"async\" src=\"https:\/\/lh3.googleusercontent.com\/a-\/ALV-UjVpXSVvD9DAQWMdfboKG-wZWchBh8DFgehJ5a7IR1v4mkemXx4T=w144-h144-p-rp-mo-ba3-br100\" alt=\"Cameron Gillihan\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t\t\t<cite class=\"elementor-testimonial__cite\"><span class=\"elementor-testimonial__name\">Cameron Gillihan<\/span><div class=\"elementor-star-rating\"><i class=\"elementor-star-full\">&#xE934;<\/i><i class=\"elementor-star-full\">&#xE934;<\/i><i class=\"elementor-star-full\">&#xE934;<\/i><i class=\"elementor-star-full\">&#xE934;<\/i><i class=\"elementor-star-full\">&#xE934;<\/i><\/div><\/cite>\t\t\t\t\t<div class=\"elementor-testimonial__icon elementor-icon elementor-icon-\" aria-label=\"Read More\"><svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" width=\"800px\" height=\"800px\" viewBox=\"-3 0 262 262\" preserveAspectRatio=\"xMidYMid\"><path d=\"M255.878 133.451c0-10.734-.871-18.567-2.756-26.69H130.55v48.448h71.947c-1.45 12.04-9.283 30.172-26.69 42.356l-.244 1.622 38.755 30.023 2.685.268c24.659-22.774 38.875-56.282 38.875-96.027\" fill=\"#4285F4\"><\/path><path d=\"M130.55 261.1c35.248 0 64.839-11.605 86.453-31.622l-41.196-31.913c-11.024 7.688-25.82 13.055-45.257 13.055-34.523 0-63.824-22.773-74.269-54.25l-1.531.13-40.298 31.187-.527 1.465C35.393 231.798 79.49 261.1 130.55 261.1\" fill=\"#34A853\"><\/path><path d=\"M56.281 156.37c-2.756-8.123-4.351-16.827-4.351-25.82 0-8.994 1.595-17.697 4.206-25.82l-.073-1.73L15.26 71.312l-1.335.635C5.077 89.644 0 109.517 0 130.55s5.077 40.905 13.925 58.602l42.356-32.782\" fill=\"#FBBC05\"><\/path><path d=\"M130.55 50.479c24.514 0 41.05 10.589 50.479 19.438l36.844-35.974C195.245 12.91 165.798 0 130.55 0 79.49 0 35.393 29.301 13.925 71.947l42.211 32.783c10.59-31.477 39.891-54.251 74.414-54.251\" fill=\"#EB4335\"><\/path><\/svg><\/div>\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial__content\">\n\t\t\t\t\t<div class=\"elementor-testimonial__text\">\n\t\t\t\t\t\tWe had Brian and his team Marcos & Jackson put in a privacy fence for us. The work done was outstanding and the fence looks great. I\u2019m overjoyed by the job they did dealing with the \u2018less-than-friendly\u201d rock pile we live on. The work was done efficiently, clean, and fast. I don\u2019t think I heard one curse-word uttered. These guys are clean, professional, quick, and darn good at what they do! I couldn\u2019t recommend them more and we\u2019ll be calling them again to put in our deck! Thx guys!!!\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"swiper-slide\" role=\"group\" aria-roledescription=\"slide\">\n\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial elementor-repeater-item-1d82a37\">\n\t\t\t\t\t\t\t<div class=\"elementor-testimonial__header\">\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial__image\">\n\t\t\t\t\t\t\t<img decoding=\"async\" src=\"https:\/\/lh3.googleusercontent.com\/a\/ACg8ocJP4hMwTLpSQNT6WW0Av0s7pLpu8Kxvb6MSde85eOU7Z_-Wlg=w144-h144-p-rp-mo-br100\" alt=\"Austin A\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t\t\t<cite class=\"elementor-testimonial__cite\"><span class=\"elementor-testimonial__name\">Austin A<\/span><div class=\"elementor-star-rating\"><i class=\"elementor-star-full\">&#xE934;<\/i><i class=\"elementor-star-full\">&#xE934;<\/i><i class=\"elementor-star-full\">&#xE934;<\/i><i class=\"elementor-star-full\">&#xE934;<\/i><i class=\"elementor-star-full\">&#xE934;<\/i><\/div><\/cite>\t\t\t\t\t<div class=\"elementor-testimonial__icon elementor-icon elementor-icon-\" aria-label=\"Read More\"><svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" width=\"800px\" height=\"800px\" viewBox=\"-3 0 262 262\" preserveAspectRatio=\"xMidYMid\"><path d=\"M255.878 133.451c0-10.734-.871-18.567-2.756-26.69H130.55v48.448h71.947c-1.45 12.04-9.283 30.172-26.69 42.356l-.244 1.622 38.755 30.023 2.685.268c24.659-22.774 38.875-56.282 38.875-96.027\" fill=\"#4285F4\"><\/path><path d=\"M130.55 261.1c35.248 0 64.839-11.605 86.453-31.622l-41.196-31.913c-11.024 7.688-25.82 13.055-45.257 13.055-34.523 0-63.824-22.773-74.269-54.25l-1.531.13-40.298 31.187-.527 1.465C35.393 231.798 79.49 261.1 130.55 261.1\" fill=\"#34A853\"><\/path><path d=\"M56.281 156.37c-2.756-8.123-4.351-16.827-4.351-25.82 0-8.994 1.595-17.697 4.206-25.82l-.073-1.73L15.26 71.312l-1.335.635C5.077 89.644 0 109.517 0 130.55s5.077 40.905 13.925 58.602l42.356-32.782\" fill=\"#FBBC05\"><\/path><path d=\"M130.55 50.479c24.514 0 41.05 10.589 50.479 19.438l36.844-35.974C195.245 12.91 165.798 0 130.55 0 79.49 0 35.393 29.301 13.925 71.947l42.211 32.783c10.59-31.477 39.891-54.251 74.414-54.251\" fill=\"#EB4335\"><\/path><\/svg><\/div>\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial__content\">\n\t\t\t\t\t<div class=\"elementor-testimonial__text\">\n\t\t\t\t\t\tThis team did such an amazing job building my pergola cover and enclosing my deck. Very professional and quality work. All of their suggestions for design were great, and I would recommend them for any project.\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"swiper-slide\" role=\"group\" aria-roledescription=\"slide\">\n\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial elementor-repeater-item-728a1c1\">\n\t\t\t\t\t\t\t<div class=\"elementor-testimonial__header\">\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial__image\">\n\t\t\t\t\t\t\t<img decoding=\"async\" src=\"https:\/\/lh3.googleusercontent.com\/a\/ACg8ocILY5Ybz7s9Q7XVKVKcvAxyDocwqrZN0jOCDx6Se4lE9cCyUrw=w144-h144-p-rp-mo-br100\" alt=\"Courtney Croak\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t\t\t<cite class=\"elementor-testimonial__cite\"><span class=\"elementor-testimonial__name\">Courtney Croak<\/span><div class=\"elementor-star-rating\"><i class=\"elementor-star-full\">&#xE934;<\/i><i class=\"elementor-star-full\">&#xE934;<\/i><i class=\"elementor-star-full\">&#xE934;<\/i><i class=\"elementor-star-full\">&#xE934;<\/i><i class=\"elementor-star-full\">&#xE934;<\/i><\/div><\/cite>\t\t\t\t\t<div class=\"elementor-testimonial__icon elementor-icon elementor-icon-\" aria-label=\"Read More\"><svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" width=\"800px\" height=\"800px\" viewBox=\"-3 0 262 262\" preserveAspectRatio=\"xMidYMid\"><path d=\"M255.878 133.451c0-10.734-.871-18.567-2.756-26.69H130.55v48.448h71.947c-1.45 12.04-9.283 30.172-26.69 42.356l-.244 1.622 38.755 30.023 2.685.268c24.659-22.774 38.875-56.282 38.875-96.027\" fill=\"#4285F4\"><\/path><path d=\"M130.55 261.1c35.248 0 64.839-11.605 86.453-31.622l-41.196-31.913c-11.024 7.688-25.82 13.055-45.257 13.055-34.523 0-63.824-22.773-74.269-54.25l-1.531.13-40.298 31.187-.527 1.465C35.393 231.798 79.49 261.1 130.55 261.1\" fill=\"#34A853\"><\/path><path d=\"M56.281 156.37c-2.756-8.123-4.351-16.827-4.351-25.82 0-8.994 1.595-17.697 4.206-25.82l-.073-1.73L15.26 71.312l-1.335.635C5.077 89.644 0 109.517 0 130.55s5.077 40.905 13.925 58.602l42.356-32.782\" fill=\"#FBBC05\"><\/path><path d=\"M130.55 50.479c24.514 0 41.05 10.589 50.479 19.438l36.844-35.974C195.245 12.91 165.798 0 130.55 0 79.49 0 35.393 29.301 13.925 71.947l42.211 32.783c10.59-31.477 39.891-54.251 74.414-54.251\" fill=\"#EB4335\"><\/path><\/svg><\/div>\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial__content\">\n\t\t\t\t\t<div class=\"elementor-testimonial__text\">\n\t\t\t\t\t\tWe have worked with Christian and his team for numerous projects around our home for the past year. They built and stained a beautiful fence for us, and also built a paver patio and pathway in our backyard. They are consistently friendly, communicative, and deliver high-quality work. Their employees are considerate and helpful. They have excellent follow-through from start to finish, and are exceptionally priced. We would highly recommend this team and we will continue to utilize their skills around our home going forward.\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-swiper-button elementor-swiper-button-prev\" role=\"button\" tabindex=\"0\" aria-label=\"Previous\">\n\t\t\t\t\t\t\t<svg aria-hidden=\"true\" class=\"e-font-icon-svg e-eicon-chevron-left\" viewBox=\"0 0 1000 1000\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M646 125C629 125 613 133 604 142L308 442C296 454 292 471 292 487 292 504 296 521 308 533L604 854C617 867 629 875 646 875 663 875 679 871 692 858 704 846 713 829 713 812 713 796 708 779 692 767L438 487 692 225C700 217 708 204 708 187 708 171 704 154 692 142 675 129 663 125 646 125Z\"><\/path><\/svg>\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t<div class=\"elementor-swiper-button elementor-swiper-button-next\" role=\"button\" tabindex=\"0\" aria-label=\"Next\">\n\t\t\t\t\t\t\t<svg aria-hidden=\"true\" class=\"e-font-icon-svg e-eicon-chevron-right\" viewBox=\"0 0 1000 1000\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M696 533C708 521 713 504 713 487 713 471 708 454 696 446L400 146C388 133 375 125 354 125 338 125 325 129 313 142 300 154 292 171 292 187 292 204 296 221 308 233L563 492 304 771C292 783 288 800 288 817 288 833 296 850 308 863 321 871 338 875 354 875 371 875 388 867 400 854L696 533Z\"><\/path><\/svg>\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"swiper-pagination\"><\/div>\n\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-21f3f805 elementor-section-height-min-height elementor-section-boxed elementor-section-height-default elementor-section-items-middle\" data-id=\"21f3f805\" data-element_type=\"section\" data-e-type=\"section\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;,&quot;jet_parallax_layout_list&quot;:[]}\">\n\t\t\t\t\t\t\t<div class=\"elementor-background-overlay\"><\/div>\n\t\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-6106dea5\" data-id=\"6106dea5\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<section class=\"elementor-section elementor-inner-section elementor-element elementor-element-204902ce elementor-section-full_width elementor-section-height-default elementor-section-height-default\" data-id=\"204902ce\" data-element_type=\"section\" data-e-type=\"section\" data-settings=\"{&quot;jet_parallax_layout_list&quot;:[]}\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-inner-column elementor-element elementor-element-4d93926f\" data-id=\"4d93926f\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-4705e712 elementor-widget elementor-widget-ucaddon_image_reveal_on_scroll\" data-id=\"4705e712\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"ucaddon_image_reveal_on_scroll.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\n<!-- start Scroll Image Reveal -->\n\t\t<link id='uc_ac_assets_file_uc_image_reveal_css_545-css' href='https:\/\/harrisandsons.co\/wp-content\/uploads\/ac_assets\/image_reveal_on_scroll\/uc_image_reveal.css' type='text\/css' rel='stylesheet' >\n\n<style>\/* widget: Scroll Image Reveal *\/\n\n    #uc_image_reveal_on_scroll_elementor_4705e712 .uc_overlay{\n      right: 0;\n\t} \n\t\n\n\n\n\n#uc_image_reveal_on_scroll_elementor_4705e712 .uc_reveal{\n\ttransition: ease-in-out all 2s;\n    transition-delay: 250ms;\n}\n\n#uc_image_reveal_on_scroll_elementor_4705e712 img\n{\n  display:block;\n}\n\n<\/style>\n\n<div class=\"uc_image_reveal\" id=\"uc_image_reveal_on_scroll_elementor_4705e712\">\n\t<div class=\"uc_image_reveal_box\">\n      \t          \n\t\t<img decoding=\"async\" src=\"https:\/\/i0.wp.com\/landobuilderscorp.com\/wp-content\/uploads\/2025\/03\/Nav-2.jpg?w=1200&amp;#038;ssl=1\" class=\"ue-img\" alt=\"\" width=\"100%\"  src=\"https:\/\/i0.wp.com\/landobuilderscorp.com\/wp-content\/uploads\/2025\/03\/Nav-2.jpg?w=1200&#038;ssl=1\">\n          \n              \n\t\t<div class=\"uc_overlay iv-jello\"><\/div>\n        \n\t<\/div>\n<\/div>\n<!-- end Scroll Image Reveal -->\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-inner-column elementor-element elementor-element-7a1763b6\" data-id=\"7a1763b6\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-72e72e90 elementor-widget elementor-widget-text-editor\" data-id=\"72e72e90\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p><span style=\"color: #808080;\">Why Invest in a<\/span> <strong>Home Sauna or Steam Room?<\/strong><\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-59c95371 elementor-widget elementor-widget-text-editor\" data-id=\"59c95371\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<ul><li data-start=\"1007\" data-end=\"1259\"><strong data-start=\"1007\" data-end=\"1028\">Health Benefits<\/strong>:<br data-start=\"1029\" data-end=\"1032\" \/>Regular use of saunas and steam rooms can promote circulation, reduce stress, flush toxins, clear the skin, ease joint pain, and improve sleep quality. It\u2019s more than just comfort\u2014it\u2019s a long-term investment in your well-being.<br \/><br \/><\/li><li data-start=\"1261\" data-end=\"1494\"><strong data-start=\"1261\" data-end=\"1287\">Boost Property Value<\/strong>:<br data-start=\"1288\" data-end=\"1291\" \/>Buyers are increasingly drawn to homes with wellness features. A professionally designed sauna or steam room not only enhances your daily living experience\u2014it <strong data-start=\"1450\" data-end=\"1476\">adds real resale value<\/strong> to your property.<br \/><br \/><\/li><li data-start=\"1496\" data-end=\"1744\"><strong data-start=\"1496\" data-end=\"1523\">Luxury Meets Function<\/strong>:<br data-start=\"1524\" data-end=\"1527\" \/>Our team at Harris &amp; Sons combines sophisticated design with advanced heating, ventilation, and waterproofing systems. The result? A <strong data-start=\"1660\" data-end=\"1693\">stunning and functional space<\/strong> that will last for years with minimal maintenance.<br \/><br \/><\/li><li data-start=\"1746\" data-end=\"1980\"><strong data-start=\"1746\" data-end=\"1778\">Fully Customized Solutions<\/strong>:<br data-start=\"1779\" data-end=\"1782\" \/>From traditional wood-fired saunas to modern infrared or hybrid steam-sauna combos, we tailor every detail to your preferences\u2014from wood finish and lighting to control systems and sound integration.<\/li><\/ul>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-ab0162e elementor-section-height-min-height elementor-section-boxed elementor-section-height-default elementor-section-items-middle\" data-id=\"ab0162e\" data-element_type=\"section\" data-e-type=\"section\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;,&quot;jet_parallax_layout_list&quot;:[]}\">\n\t\t\t\t\t\t\t<div class=\"elementor-background-overlay\"><\/div>\n\t\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-18873b12\" data-id=\"18873b12\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<section class=\"elementor-section elementor-inner-section elementor-element elementor-element-4565ff0b elementor-section-full_width elementor-section-height-default elementor-section-height-default\" data-id=\"4565ff0b\" data-element_type=\"section\" data-e-type=\"section\" data-settings=\"{&quot;jet_parallax_layout_list&quot;:[]}\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-inner-column elementor-element elementor-element-6b7d5719\" data-id=\"6b7d5719\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-1926ae4 elementor-widget elementor-widget-text-editor\" data-id=\"1926ae4\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p><strong>Our Premium Sauna &amp; Steam Room Services<\/strong><\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-inner-section elementor-element elementor-element-77547661 elementor-section-full_width elementor-section-height-default elementor-section-height-default\" data-id=\"77547661\" data-element_type=\"section\" data-e-type=\"section\" data-settings=\"{&quot;jet_parallax_layout_list&quot;:[]}\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-33 elementor-inner-column elementor-element elementor-element-41f5e477\" data-id=\"41f5e477\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-705f385d elementor-widget elementor-widget-ucaddon_square_icon_box\" data-id=\"705f385d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"ucaddon_square_icon_box.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\n<!-- start Icon Box -->\n\t\t<link id='font-awesome-css' href='https:\/\/harrisandsons.co\/wp-content\/plugins\/unlimited-elements-for-elementor\/assets_libraries\/font-awesome6\/fontawesome-all.min.css' type='text\/css' rel='stylesheet' >\n\t\t<link id='font-awesome-4-shim-css' href='https:\/\/harrisandsons.co\/wp-content\/plugins\/unlimited-elements-for-elementor\/assets_libraries\/font-awesome6\/fontawesome-v4-shims.min.css' type='text\/css' rel='stylesheet' >\n\n<style>\/* widget: Icon Box *\/\n\n#uc_square_icon_box_elementor_705f385d * { \n\tbox-sizing: border-box; \n}\n\n#uc_square_icon_box_elementor_705f385d{\n  font-family: inherit;\n  position:relative;\n}\n#uc_square_icon_box_elementor_705f385d svg{\n  width:1em;\n  height:1em;\n}\n#uc_square_icon_box_elementor_705f385d .blox-boxed-small-square-icon-box-icon{\n\tposition:relative;\n    display:flex;\n    justify-content:center;\n    align-items:center;\n    transform:rotate(0deg);\n    z-index:2;\n}\n#uc_square_icon_box_elementor_705f385d .ue-icon {\n  display:inline-block;\n}\n#uc_square_icon_box_elementor_705f385d .blox-boxed-small-square-icon-box-icon > div{\n\tposition:relative;\n    display:flex;\n    justify-content:center;\n    align-items:center;\n}\n#uc_square_icon_box_elementor_705f385d .ue-icon-inner{\n    line-height:1em;\n\t} \t\n\n\n#uc_square_icon_box_elementor_705f385d .ue-icon-inner svg{\n    height:1em;\n    width:1em;\n\t} \t\n\t\n.blox-boxed-small-square-icon-box-heading{\n\tfont-size:21px;\n\t}\n\n\n#uc_square_icon_box_elementor_705f385d:hover\n{\n  position:relative;\n  z-index:1;\n}\n\n\n#uc_square_icon_box_elementor_705f385d .ue-title-separator span\n{\n  display:inline-block;\n}\n\n\n\n\n<\/style>\n\n<div class=\"square_icon_box elementor-animation-float\" id=\"uc_square_icon_box_elementor_705f385d\">\n  \n         \n                <div  class=\"blox-boxed-small-square-icon-box-heading\">Custom Sauna Design & Build<\/div>\n         \n  \t\t             <div class=\"ue-title-separator\">\n               <span><\/span>\n             <\/div>\n          \n  \n                <div class=\"blox-boxed-small-square-icon-box-content\">\n        \t<p data-start=\"801\" data-end=\"1144\">Experience the full benefits of dry heat therapy with a tailor-made sauna built to your exact preferences. We use top-tier materials like <strong data-start=\"939\" data-end=\"948\">cedar<\/strong>, <strong data-start=\"950\" data-end=\"961\">hemlock<\/strong>, and <strong data-start=\"967\" data-end=\"997\">thermally treated hardwood<\/strong> for long-lasting beauty and performance. Whether you\u2019re after a traditional Nordic look or a sleek modern aesthetic, we bring your vision to life.<\/p>\n        <\/div>\n          \n  \t\t        \n          \n  \t\t\n  \t\t  \n<\/div>\n<!-- end Icon Box -->\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t<div class=\"elementor-column elementor-col-33 elementor-inner-column elementor-element elementor-element-5a38d090\" data-id=\"5a38d090\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-bfc57c3 elementor-widget elementor-widget-ucaddon_square_icon_box\" data-id=\"bfc57c3\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"ucaddon_square_icon_box.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\n<!-- start Icon Box -->\n\n<style>\/* widget: Icon Box *\/\n\n#uc_square_icon_box_elementor_bfc57c3 * { \n\tbox-sizing: border-box; \n}\n\n#uc_square_icon_box_elementor_bfc57c3{\n  font-family: inherit;\n  position:relative;\n}\n#uc_square_icon_box_elementor_bfc57c3 svg{\n  width:1em;\n  height:1em;\n}\n#uc_square_icon_box_elementor_bfc57c3 .blox-boxed-small-square-icon-box-icon{\n\tposition:relative;\n    display:flex;\n    justify-content:center;\n    align-items:center;\n    transform:rotate(0deg);\n    z-index:2;\n}\n#uc_square_icon_box_elementor_bfc57c3 .ue-icon {\n  display:inline-block;\n}\n#uc_square_icon_box_elementor_bfc57c3 .blox-boxed-small-square-icon-box-icon > div{\n\tposition:relative;\n    display:flex;\n    justify-content:center;\n    align-items:center;\n}\n#uc_square_icon_box_elementor_bfc57c3 .ue-icon-inner{\n    line-height:1em;\n\t} \t\n\n\n#uc_square_icon_box_elementor_bfc57c3 .ue-icon-inner svg{\n    height:1em;\n    width:1em;\n\t} \t\n\t\n.blox-boxed-small-square-icon-box-heading{\n\tfont-size:21px;\n\t}\n\n\n#uc_square_icon_box_elementor_bfc57c3:hover\n{\n  position:relative;\n  z-index:1;\n}\n\n\n#uc_square_icon_box_elementor_bfc57c3 .ue-title-separator span\n{\n  display:inline-block;\n}\n\n\n\n\n<\/style>\n\n<div class=\"square_icon_box elementor-animation-float\" id=\"uc_square_icon_box_elementor_bfc57c3\">\n  \n         \n                <div  class=\"blox-boxed-small-square-icon-box-heading\">Luxury Steam Room Construction<\/div>\n         \n  \t\t             <div class=\"ue-title-separator\">\n               <span><\/span>\n             <\/div>\n          \n  \n                <div class=\"blox-boxed-small-square-icon-box-content\">\n        \t<p data-start=\"1192\" data-end=\"1478\">Indulge in the soothing effects of a fully customized steam room, designed with <strong data-start=\"1272\" data-end=\"1304\">moisture-resistant materials<\/strong>, <strong data-start=\"1306\" data-end=\"1326\">digital controls<\/strong>, and <strong data-start=\"1332\" data-end=\"1362\">aromatherapy compatibility<\/strong>. We pay close attention to waterproofing, drainage, and ventilation\u2014so you can enjoy pure relaxation without worry.<\/p>\n        <\/div>\n          \n  \t\t        \n          \n  \t\t\n  \t\t  \n<\/div>\n<!-- end Icon Box -->\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t<div class=\"elementor-column elementor-col-33 elementor-inner-column elementor-element elementor-element-447a4c07\" data-id=\"447a4c07\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-55d72d4a elementor-widget elementor-widget-ucaddon_square_icon_box\" data-id=\"55d72d4a\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"ucaddon_square_icon_box.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\n<!-- start Icon Box -->\n\n<style>\/* widget: Icon Box *\/\n\n#uc_square_icon_box_elementor_55d72d4a * { \n\tbox-sizing: border-box; \n}\n\n#uc_square_icon_box_elementor_55d72d4a{\n  font-family: inherit;\n  position:relative;\n}\n#uc_square_icon_box_elementor_55d72d4a svg{\n  width:1em;\n  height:1em;\n}\n#uc_square_icon_box_elementor_55d72d4a .blox-boxed-small-square-icon-box-icon{\n\tposition:relative;\n    display:flex;\n    justify-content:center;\n    align-items:center;\n    transform:rotate(0deg);\n    z-index:2;\n}\n#uc_square_icon_box_elementor_55d72d4a .ue-icon {\n  display:inline-block;\n}\n#uc_square_icon_box_elementor_55d72d4a .blox-boxed-small-square-icon-box-icon > div{\n\tposition:relative;\n    display:flex;\n    justify-content:center;\n    align-items:center;\n}\n#uc_square_icon_box_elementor_55d72d4a .ue-icon-inner{\n    line-height:1em;\n\t} \t\n\n\n#uc_square_icon_box_elementor_55d72d4a .ue-icon-inner svg{\n    height:1em;\n    width:1em;\n\t} \t\n\t\n.blox-boxed-small-square-icon-box-heading{\n\tfont-size:21px;\n\t}\n\n\n#uc_square_icon_box_elementor_55d72d4a:hover\n{\n  position:relative;\n  z-index:1;\n}\n\n\n#uc_square_icon_box_elementor_55d72d4a .ue-title-separator span\n{\n  display:inline-block;\n}\n\n\n\n\n<\/style>\n\n<div class=\"square_icon_box elementor-animation-float\" id=\"uc_square_icon_box_elementor_55d72d4a\">\n  \n         \n                <div  class=\"blox-boxed-small-square-icon-box-heading\">Advanced Heating & Ventilation Systems<\/div>\n         \n  \t\t             <div class=\"ue-title-separator\">\n               <span><\/span>\n             <\/div>\n          \n  \n                <div class=\"blox-boxed-small-square-icon-box-content\">\n        \t<p data-start=\"1534\" data-end=\"1804\">We install high-efficiency <strong data-start=\"1561\" data-end=\"1581\">steam generators<\/strong>, <strong data-start=\"1583\" data-end=\"1602\">infrared panels<\/strong>, and <strong data-start=\"1608\" data-end=\"1638\">professional-grade heaters<\/strong> engineered for durability and energy savings. With <strong data-start=\"1690\" data-end=\"1720\">custom ventilation systems<\/strong>, we ensure every space remains safe, clean, and comfortable\u2014even with frequent use.<\/p>\n        <\/div>\n          \n  \t\t        \n          \n  \t\t\n  \t\t  \n<\/div>\n<!-- end Icon Box -->\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-inner-section elementor-element elementor-element-7f6061fb elementor-section-full_width elementor-section-height-default elementor-section-height-default\" data-id=\"7f6061fb\" data-element_type=\"section\" data-e-type=\"section\" data-settings=\"{&quot;jet_parallax_layout_list&quot;:[]}\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-33 elementor-inner-column elementor-element elementor-element-294abb80\" data-id=\"294abb80\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-107db645 elementor-widget elementor-widget-ucaddon_square_icon_box\" data-id=\"107db645\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"ucaddon_square_icon_box.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\n<!-- start Icon Box -->\n\n<style>\/* widget: Icon Box *\/\n\n#uc_square_icon_box_elementor_107db645 * { \n\tbox-sizing: border-box; \n}\n\n#uc_square_icon_box_elementor_107db645{\n  font-family: inherit;\n  position:relative;\n}\n#uc_square_icon_box_elementor_107db645 svg{\n  width:1em;\n  height:1em;\n}\n#uc_square_icon_box_elementor_107db645 .blox-boxed-small-square-icon-box-icon{\n\tposition:relative;\n    display:flex;\n    justify-content:center;\n    align-items:center;\n    transform:rotate(0deg);\n    z-index:2;\n}\n#uc_square_icon_box_elementor_107db645 .ue-icon {\n  display:inline-block;\n}\n#uc_square_icon_box_elementor_107db645 .blox-boxed-small-square-icon-box-icon > div{\n\tposition:relative;\n    display:flex;\n    justify-content:center;\n    align-items:center;\n}\n#uc_square_icon_box_elementor_107db645 .ue-icon-inner{\n    line-height:1em;\n\t} \t\n\n\n#uc_square_icon_box_elementor_107db645 .ue-icon-inner svg{\n    height:1em;\n    width:1em;\n\t} \t\n\t\n.blox-boxed-small-square-icon-box-heading{\n\tfont-size:21px;\n\t}\n\n\n#uc_square_icon_box_elementor_107db645:hover\n{\n  position:relative;\n  z-index:1;\n}\n\n\n#uc_square_icon_box_elementor_107db645 .ue-title-separator span\n{\n  display:inline-block;\n}\n\n\n\n\n<\/style>\n\n<div class=\"square_icon_box elementor-animation-float\" id=\"uc_square_icon_box_elementor_107db645\">\n  \n         \n                <div  class=\"blox-boxed-small-square-icon-box-heading\">Smart Sauna & Steam Room Features<\/div>\n         \n  \t\t             <div class=\"ue-title-separator\">\n               <span><\/span>\n             <\/div>\n          \n  \n                <div class=\"blox-boxed-small-square-icon-box-content\">\n        \t<p data-start=\"1855\" data-end=\"2114\">Upgrade your wellness space with <strong data-start=\"1888\" data-end=\"1909\">modern smart tech<\/strong>. From <strong data-start=\"1916\" data-end=\"1937\">LED mood lighting<\/strong> and <strong data-start=\"1942\" data-end=\"1961\">Bluetooth audio<\/strong> to <strong data-start=\"1965\" data-end=\"1995\">remote temperature control<\/strong> and <strong data-start=\"2000\" data-end=\"2026\">aroma infusion systems<\/strong>, your new sauna or steam room will blend comfort, luxury, and convenience effortlessly.<\/p>\n        <\/div>\n          \n  \t\t        \n          \n  \t\t\n  \t\t  \n<\/div>\n<!-- end Icon Box -->\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t<div class=\"elementor-column elementor-col-33 elementor-inner-column elementor-element elementor-element-3c72af6b\" data-id=\"3c72af6b\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-5b737b27 elementor-widget elementor-widget-ucaddon_square_icon_box\" data-id=\"5b737b27\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"ucaddon_square_icon_box.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\n<!-- start Icon Box -->\n\n<style>\/* widget: Icon Box *\/\n\n#uc_square_icon_box_elementor_5b737b27 * { \n\tbox-sizing: border-box; \n}\n\n#uc_square_icon_box_elementor_5b737b27{\n  font-family: inherit;\n  position:relative;\n}\n#uc_square_icon_box_elementor_5b737b27 svg{\n  width:1em;\n  height:1em;\n}\n#uc_square_icon_box_elementor_5b737b27 .blox-boxed-small-square-icon-box-icon{\n\tposition:relative;\n    display:flex;\n    justify-content:center;\n    align-items:center;\n    transform:rotate(0deg);\n    z-index:2;\n}\n#uc_square_icon_box_elementor_5b737b27 .ue-icon {\n  display:inline-block;\n}\n#uc_square_icon_box_elementor_5b737b27 .blox-boxed-small-square-icon-box-icon > div{\n\tposition:relative;\n    display:flex;\n    justify-content:center;\n    align-items:center;\n}\n#uc_square_icon_box_elementor_5b737b27 .ue-icon-inner{\n    line-height:1em;\n\t} \t\n\n\n#uc_square_icon_box_elementor_5b737b27 .ue-icon-inner svg{\n    height:1em;\n    width:1em;\n\t} \t\n\t\n.blox-boxed-small-square-icon-box-heading{\n\tfont-size:21px;\n\t}\n\n\n#uc_square_icon_box_elementor_5b737b27:hover\n{\n  position:relative;\n  z-index:1;\n}\n\n\n#uc_square_icon_box_elementor_5b737b27 .ue-title-separator span\n{\n  display:inline-block;\n}\n\n\n\n\n<\/style>\n\n<div class=\"square_icon_box elementor-animation-float\" id=\"uc_square_icon_box_elementor_5b737b27\">\n  \n         \n                <div  class=\"blox-boxed-small-square-icon-box-heading\">Wellness & Spa Integration<\/div>\n         \n  \t\t             <div class=\"ue-title-separator\">\n               <span><\/span>\n             <\/div>\n          \n  \n                <div class=\"blox-boxed-small-square-icon-box-content\">\n        \t<p data-start=\"2158\" data-end=\"2442\">Want to turn your <strong data-start=\"2176\" data-end=\"2191\">master bath<\/strong>, <strong data-start=\"2193\" data-end=\"2208\">guest suite<\/strong>, or <strong data-start=\"2213\" data-end=\"2232\">basement corner<\/strong> into a luxury spa? We\u2019ll integrate your sauna or steam room seamlessly into existing layouts or help you build out a full wellness wing\u2014complete with spa showers, soaking tubs, and custom cabinetry if desired.<\/p>\n        <\/div>\n          \n  \t\t        \n          \n  \t\t\n  \t\t  \n<\/div>\n<!-- end Icon Box -->\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t<div class=\"elementor-column elementor-col-33 elementor-inner-column elementor-element elementor-element-3f563176\" data-id=\"3f563176\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap\">\n\t\t\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-505269f5 elementor-section-height-min-height elementor-section-boxed elementor-section-height-default elementor-section-items-middle\" data-id=\"505269f5\" data-element_type=\"section\" data-e-type=\"section\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;,&quot;jet_parallax_layout_list&quot;:[]}\">\n\t\t\t\t\t\t\t<div class=\"elementor-background-overlay\"><\/div>\n\t\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-4ae48acb\" data-id=\"4ae48acb\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<section class=\"elementor-section elementor-inner-section elementor-element elementor-element-63aebd6b el