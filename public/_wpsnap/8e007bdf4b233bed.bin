ot;:&quot;classic&quot;,&quot;jet_parallax_layout_list&quot;:[]}\">\n\t\t\t\t\t\t\t<div class=\"elementor-background-overlay\"><\/div>\n\t\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-881bba6\" data-id=\"881bba6\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<section class=\"elementor-section elementor-inner-section elementor-element elementor-element-9575609 elementor-section-full_width elementor-section-height-default elementor-section-height-default\" data-id=\"9575609\" data-element_type=\"section\" data-e-type=\"section\" data-settings=\"{&quot;jet_parallax_layout_list&quot;:[]}\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-inner-column elementor-element elementor-element-149dca1\" data-id=\"149dca1\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-763879e elementor-widget elementor-widget-text-editor\" data-id=\"763879e\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p><strong>Invest in Your Home&#8217;s Value<\/strong><\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-337aeca elementor-widget elementor-widget-text-editor\" data-id=\"337aeca\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p>Whether you&#8217;re considering a bathroom renovation, kitchen upgrade, or an ADU addition, these remodels drastically increase your home&#8217;s value. This means homeowners will have more equity if they want to pull out a HELOC loan, or they will get much more resale value when they decide to sell the home. Some projects recoup 125% of their costs, meaning they bring more value and make more money to homeowners than they cost.<\/p><p>Download recent study from the Portland and general Pacific area, which shows average costs of projects, resale value added, and cost recouped.<\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-8fefef9 elementor-widget elementor-widget-ucaddon_color_overlay_button\" data-id=\"8fefef9\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"ucaddon_color_overlay_button.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\n<!-- start Overlay Button -->\n<style>\/* widget: Overlay Button *\/\n\n#uc_color_overlay_button_elementor_8fefef9 a.color-overlay-link\n{\n  display:inline-block;\n  position:relative;\n  text-decoration:none;\n  overflow:hidden;\n}\n\n#uc_color_overlay_button_elementor_8fefef9 a span.ue-color-overlay\n{\n  display:block;\n  position:absolute;\n  top:0px;\n  left:0px;\n}\n\n#uc_color_overlay_button_elementor_8fefef9 a .ue-btn-txt\n{\n  position:relative;\n  display: flex;\n  align-items: center;\n  flex-direction: row;\n}\n#uc_color_overlay_button_elementor_8fefef9 a .ue-btn-txt svg\n{\n  width:1em;\n  height:1em;\n}\n\n<\/style>\n\n<div id=\"uc_color_overlay_button_elementor_8fefef9\" class=\"color-overlay-button\">\n  <a href=\"https:\/\/harrisandsons.co\/wp-content\/uploads\/2025\/09\/2024-Pacific-Remodels-Cost-VS-Value.pdf\" class=\"color-overlay-link elementor-animation-grow\" download=\"\">\n    <span class=\"ue-color-overlay\"><\/span>\n    <span class=\"ue-btn-txt\">DOWNLOAD PDF <i class='fas fa-download'><\/i><\/span>\n  <\/a>\n<\/div>\n<!-- end Overlay Button -->\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/d