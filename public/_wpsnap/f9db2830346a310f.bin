\n\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t<div class=\"elementor-field-type-textarea elementor-field-group elementor-column elementor-field-group-field_afd0c58 elementor-col-100 elementor-field-required\">\n\t\t\t\t\t\t\t\t\t\t\t\t<label for=\"form-field-field_afd0c58\" class=\"elementor-field-label elementor-screen-only\">\n\t\t\t\t\t\t\t\tYour Message\t\t\t\t\t\t\t<\/label>\n\t\t\t\t\t\t<textarea class=\"elementor-field-textual elementor-field  elementor-size-md\" name=\"form_fields[field_afd0c58]\" id=\"form-field-field_afd0c58\" rows=\"4\" placeholder=\"Your Message\" required=\"required\"><\/textarea>\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t<div class=\"elementor-field-group elementor-column elementor-field-type-submit elementor-col-100 e-form__buttons\">\n\t\t\t\t\t<button class=\"elementor-button elementor-size-md\" type=\"submit\">\n\t\t\t\t\t\t<span class=\"elementor-button-content-wrapper\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<span class=\"elementor-button-text\">SUBMIT<\/span>\n\t\t\t\t\t\t\t\t\t\t\t\t\t<\/span>\n\t\t\t\t\t<\/button>\n\t\t\t\t<\/div>\n\t\t\t<\/div>\n\t\t<\/form>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t<div class=\"elementor-element elementor-element-774037f e-flex e-con-boxed e-con e-parent\" data-id=\"774037f\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;jet_parallax_layout_list&quot;:[]}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-6607601 elementor-widget elementor-widget-html\" data-id=\"6607601\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<script type=\"application\/ld+json\">\n{\n  \"@context\": \"https:\/\/schema.org\",\n  \"@type\": \"FAQPage\",\n  \"mainEntity\": [{\n    \"@type\": \"Question\",\n    \"name\": \"What\u2019s the difference between an addition and an ADU?\",\n    \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"A home addition expands your existing living space, like adding a new bedroom, bathroom, or living area. An ADU (Accessory Dwelling Unit) is a separate, self-contained unit \u2014 often with its own kitchen, bathroom, and entrance \u2014 that can be used for guests, extended family, or even rented out for additional income.\"\n    }\n  },{\n    \"@type\": \"Question\",\n    \"name\": \"Do I need permits for an ADU?\",\n    \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"Yes, building an ADU in Sunriver, OR requires proper permits and must meet local zoning regulations. Our team at Harris & Sons handles the permitting process for you, ensuring your ADU complies with all city codes and requirements.\"\n    }\n  },{\n    \"@type\": \"Question\",\n    \"name\": \"Can I use an ADU as a rental property?\",\n    \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"Yes! ADUs are perfect for long-term rentals, guest houses, or multigenerational living.\"\n    }\n  },{\n    \"@type\": \"Question\",\n    \"name\": \"How long does it take to complete a home addition?\",\n    \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"Timelines vary, but most additions take 8\u201312 weeks from design to finish.\"\n    }\n  },{\n    \"@type\": \"Question\",\n    \"name\": \"Will a home addition increase my property value?\",\n    \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"Definitely. Additions add square footage and functionality, which increase resale value significantly.\"\n    }\n  }]\n}\n<\/script>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-0367a1c elementor-section-height-min-height elementor-section-boxed elementor-secti