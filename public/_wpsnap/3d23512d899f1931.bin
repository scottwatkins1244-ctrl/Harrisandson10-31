     \n                <div  class=\"blox-boxed-small-square-icon-box-heading\">Integrated Smart Features<\/div>\n         \n  \t\t             <div class=\"ue-title-separator\">\n               <span><\/span>\n             <\/div>\n          \n  \n                <div class=\"blox-boxed-small-square-icon-box-content\">\n        \t<p data-start=\"3083\" data-end=\"3402\">Take control of your outdoor experience with intelligent systems for lighting, heating, audio, and security. From app-controlled patio lights to built-in outdoor speakers, our smart home integration enhances usability and ensures every element of your space performs effortlessly.<\/p>\n        <\/div>\n          \n  \t\t        \n          \n  \t\t\n  \t\t  \n<\/div>\n<!-- end Icon Box -->\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-b9e8811 elementor-section-height-min-height elementor-section-boxed elementor-section-height-default elementor-section-items-middle\" data-id=\"b9e8811\" data-element_type=\"section\" data-e-type=\"section\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;,&quot;jet_parallax_layout_list&quot;:[]}\">\n\t\t\t\t\t\t\t<div class=\"elementor-background-overlay\"><\/div>\n\t\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-8ea8c9e\" data-id=\"8ea8c9e\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<section class=\"elementor-section elementor-inner-section elementor-element elementor-element-ac735b3 elementor-section-full_width elementor-section-height-default elementor-section-height-default\" data-id=