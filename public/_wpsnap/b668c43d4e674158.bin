ht-min-height elementor-section-boxed elementor-section-height-default elementor-section-items-middle\" data-id=\"87d39ff\" data-element_type=\"section\" data-e-type=\"section\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;,&quot;jet_parallax_layout_list&quot;:[]}\">\n\t\t\t\t\t\t\t<div class=\"elementor-background-overlay\"><\/div>\n\t\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-44167c8\" data-id=\"44167c8\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<section class=\"elementor-section elementor-inner-section elementor-element elementor-element-af5a24d elementor-section-full_width elementor-reverse-mobile elementor-section-height-default elementor-section-height-default\" data-id=\"af5a24d\" data-element_type=\"section\" data-e-type=\"section\" data-settings=\"{&quot;jet_parallax_layout_list&quot;:[]}\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-inner-column elementor-element elementor-element-005fc1d\" data-id=\"005fc1d\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-615a239 elementor-widget elementor-widget-text-editor\" data-id=\"615a239\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p><span style=\"color: #808080;\">Expand Your Living Space, <\/span><strong>Elevate Your Curb Appeal<\/strong><\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-bc815fb elementor-widget elementor-widget-text-editor\" data-id=\"bc815fb\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p data-start=\"241\" data-end=\"500\">At <strong data-start=\"333\" data-end=\"350\">Harris &amp; Sons<\/strong>, we specialize in transforming ordinary attics and cramped second floors into bright, spacious, and functional living spaces with beautifully designed <strong data-start=\"502\" data-end=\"522\">dormer additions<\/strong>. Whether you&#8217;re looking to add headroom, increase usable square footage, or bring in more natural light, a dormer remodel is one of the smartest and most cost-effective ways to maximize your home\u2019s potential without a full-scale addition.<\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-inner-column elementor-element elementor-element-04cbd5f\" data-id=\"04cbd5f\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-694d5b4 elementor-widget elementor-widget-image\" data-id=\"694d5b4\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img fetchpriority=\"high\" decoding=\"async\" width=\"800\" height=\"94\" src=\"https:\/\/harrisandsons.co\/wp-content\/uploads\/2025\/07\/Lets-Get-Started-4-1024x120.png\" class=\"attachment-large size-large wp-image-3172\" alt=\"Lets Get Started 4\" srcset=\"https:\/\/harrisandsons.co\/wp-content\/uploads\/2025\/07\/Lets-Get-Started-4-1024x120.png 1024w, https:\/\/harrisandsons.co\/wp-content\/uploads\/2025\/07\/Lets-Get-Started-4-300x35.png 300w, https:\/\/harrisandsons.co\/wp-content\/uploads\/2025\/07\/Lets-Get-Started-4-768x90.png 768w, https:\/\/harrisan