 elementor-widget elementor-widget-text-editor\" data-id=\"1bdcfb5\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<ul><li data-start=\"3549\" data-end=\"3580\"><p data-start=\"3551\" data-end=\"3580\">40+ Years of Experience<\/p><\/li><li data-start=\"3581\" data-end=\"3613\"><p data-start=\"3583\" data-end=\"3613\">Fully Licensed &amp; Insured<\/p><\/li><li data-start=\"3614\" data-end=\"3661\"><p data-start=\"3616\" data-end=\"3661\">Transparent Pricing with No Hidden Fees<\/p><\/li><li data-start=\"3662\" data-end=\"3711\"><p data-start=\"3664\" data-end=\"3711\">In-House Designers &amp; Structural Engineers<\/p><\/li><li data-start=\"3712\" data-end=\"3755\"><p data-start=\"3714\" data-end=\"3755\">Financing Available as Low as 6.99%<\/p><\/li><li data-start=\"3756\" data-end=\"3794\"><p data-start=\"3758\" data-end=\"3794\">Free 3D Design for New Clients<\/p><\/li><li data-start=\"3795\" data-end=\"3845\"><p data-start=\"3797\" data-end=\"3845\">Local Knowledge of Zoning &amp; Building Codes<\/p><\/li><\/ul>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-61e07c4 elementor-section-height-min-height elementor-section-boxed elementor-section-height-default elementor-section-items-middle\" data-id=\"61e07c4\" data-element_type=\"section\" data-e-type=\"section\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;,&quot;jet_parallax_layout_list&quot;:[]}\">\n\t\t\t\t\t\t\t<div class=\"elementor-background-overlay\"><\/div>\n\t\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element eleme