or":[{"embeddable":true,"href":"https:\/\/harrisandsons.co\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/harrisandsons.co\/wp-json\/wp\/v2\/comments?post=16353"}],"version-history":[{"count":1,"href":"https:\/\/harrisandsons.co\/wp-json\/wp\/v2\/posts\/16353\/revisions"}],"predecessor-version":[{"id":16354,"href":"https:\/\/harrisandsons.co\/wp-json\/wp\/v2\/posts\/16353\/revisions\/16354"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/harrisandsons.co\/wp-json\/wp\/v2\/media\/5967"}],"wp:attachment":[{"href":"https:\/\/harrisandsons.co\/wp-json\/wp\/v2\/media?parent=16353"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/harrisandsons.co\/wp-json\/wp\/v2\/categories?post=16353"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/harrisandsons.co\/wp-json\/wp\/v2\/tags?post=16353"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}